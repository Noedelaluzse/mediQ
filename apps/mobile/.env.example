# Copia este archivo a .env.local (ignorado por git) y completa los valores.
# Son IDs de cliente de Google (no son secretos). NUNCA pongas aquí client secrets ni llaves de cuentas de servicio.
# Hoy apuntan al proyecto Firebase "nuvia-dev"; al crear el proyecto de MediQ solo cambian estos valores.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Firebase (prueba de F002: guarda cuenta y perfil en Firestore). Valores de la app registrada en Firebase.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
