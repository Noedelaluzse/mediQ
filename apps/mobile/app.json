{
  "expo": {
    "name": "mediQ",
    "slug": "mediQ",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mediq",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.michysoft.mediq"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B6654",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.michysoft.mediq"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "root": "src/app/routes"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B6654",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "MediQ usa Face ID para proteger tus datos de salud."
        }
      ],
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "MediQ usa tus fotos para adjuntar la foto de tu receta.",
          "cameraPermission": "MediQ usa la cámara para tomar la foto de tu receta.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
