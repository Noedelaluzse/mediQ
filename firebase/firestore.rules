rules_version = '2';

// Reglas de Firestore de MediQ. Son la ÚNICA capa de autorización (docs/07 y docs/11): se prueban con el emulador
// (`pnpm --filter mobile test:emulator`) y se publican con `firebase deploy --only firestore:rules`.
//
// Regla general: solo el dueño (request.auth.uid == uid) lee y escribe bajo mediq_users/{uid}.
// Se enumera cada colección porque las reglas se suman (OR): un comodín `{document=**}` general anularía
// la validación de `visits`. Al agregar una colección nueva hay que listarla aquí.
service cloud.firestore {
  match /databases/{database}/documents {

    function esDueno(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Consentimiento aceptado (F031): para escribir datos de una consulta la cuenta debe haber aceptado el aviso de privacidad y los
    // términos. Las reglas no pueden listar recibos, así que exigen la versión BASE (los ids son `documento_versión`); la app puede pedir
    // una versión más nueva sin romper nada, porque los recibos viejos se conservan (son inmutables). Si algún día la versión mínima
    // debe subir, se cambian estos dos ids junto con `VERSIONES_VIGENTES` (la prueba de `consentimientoExigido.test.ts` vigila que no
    // exijan algo más nuevo de lo que la app pide). Borrar NO exige consentimiento: eliminar la cuenta debe poder borrarlo todo.
    function consentimientoAceptado(uid) {
      return exists(/databases/$(database)/documents/mediq_users/$(uid)/consents/aviso_privacidad_2026-10-06)
        && exists(/databases/$(database)/documents/mediq_users/$(uid)/consents/terminos_2026-10-06);
    }

    // F041: una referencia a otro documento de la MISMA cuenta debe existir (el uid sale de la ruta, nunca del cuerpo) y ser un id simple
    // (sin «/», que armaría otra ruta). Cada comprobación cuesta una lectura, por eso al editar solo se revisa lo que cambia:
    // una consulta anterior a la regla, o con un médico dado de baja, se sigue pudiendo editar. Un campo ausente o nulo es válido.
    function referenciaValida(d, campo, coleccion, uid) {
      return !(campo in d) || d[campo] == null
        || (request.method == 'update' && request.resource.data.get(campo, null) == resource.data.get(campo, null))
        || (d[campo] is string && d[campo].matches('^[^/]+$')
            && exists(/databases/$(database)/documents/mediq_users/$(uid)/$(coleccion)/$(d[campo])));
    }

    // Texto opcional: ausente, nulo o string de hasta `max` caracteres.
    function textoOpcional(d, campo, max) {
      return !(campo in d) || d[campo] == null || (d[campo] is string && d[campo].size() <= max);
    }

    // Texto obligatorio: string de 1 a `max` caracteres.
    function textoObligatorio(d, campo, max) {
      return campo in d && d[campo] is string && d[campo].size() >= 1 && d[campo].size() <= max;
    }

    // Fecha opcional: ausente, nula o una marca de tiempo.
    function fechaOpcional(d, campo) {
      return !(campo in d) || d[campo] == null || d[campo] is timestamp;
    }

    // Cuenta (F002). Solo los campos del modelo; el correo no es un identificador (docs/11).
    // F042: el `googleSub` que guarda la cuenta debe ser el de la identidad de Google del token, no un valor libre del cliente. El token de Firebase trae la lista
    // `firebase.identities['google.com']` y su primer elemento es el `googleSub` (comprobado con una sesión real el 2026-10-07).
    // El correo NO se compara: es informativo y no es un identificador (docs/11).
    function googleSubDelToken(d) {
      return 'firebase' in request.auth.token && 'identities' in request.auth.token.firebase
        && 'google.com' in request.auth.token.firebase.identities
        && d.googleSub == request.auth.token.firebase.identities['google.com'][0];
    }

    function usuarioValido(d) {
      return d.keys().hasOnly(['googleSub', 'email', 'displayName', 'avatarUrl', 'createdAt', 'updatedAt', 'deletedAt'])
        && d.keys().hasAll(['googleSub', 'email', 'displayName'])
        && textoObligatorio(d, 'googleSub', 128)
        && googleSubDelToken(d)
        && textoObligatorio(d, 'email', 320)
        && d.displayName is string && d.displayName.size() <= 200
        && textoOpcional(d, 'avatarUrl', 2048)
        && fechaOpcional(d, 'createdAt') && fechaOpcional(d, 'updatedAt') && fechaOpcional(d, 'deletedAt');
    }

    // Perfil de paciente (F002). El perfil propio tiene id `self` e `isSelf` verdadero; los familiares (fase 3) usan ids
    // generados con `isSelf` falso. Como el id no cambia, `isSelf` tampoco puede cambiar.
    // Una lista de alergias (F028): hasta 30 textos; «ninguna conocida» no puede convivir con alergias escritas. El largo de cada
    // texto lo valida el dominio (las reglas no recorren listas).
    function alergiasValidas(d, lista, ninguna) {
      return (!d.keys().hasAny([lista]) || (d[lista] is list && d[lista].size() <= 30))
        && (!d.keys().hasAny([ninguna]) || d[ninguna] is bool)
        && !(d.keys().hasAny([lista, ninguna]) && d.keys().hasAll([lista, ninguna]) && d[ninguna] == true && d[lista].size() > 0);
    }

    // Perfil (RF-02). Datos de salud del propio usuario (F028): fecha de nacimiento `AAAA-MM-DD`, sexo, tipo de sangre y alergias.
    function pacienteValido(d, id) {
      return d.keys().hasOnly(['fullName', 'birthDate', 'isSelf', 'createdAt', 'updatedAt', 'deletedAt',
          'sex', 'bloodType', 'allergies', 'noKnownAllergies', 'drugAllergies', 'noKnownDrugAllergies'])
        && d.keys().hasAll(['fullName', 'isSelf'])
        && textoObligatorio(d, 'fullName', 200)
        && d.isSelf is bool && d.isSelf == (id == 'self')
        && (!d.keys().hasAny(['birthDate']) || (d.birthDate is string && d.birthDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && (!d.keys().hasAny(['sex']) || d.sex in ['female', 'male', 'other', 'undisclosed'])
        && (!d.keys().hasAny(['bloodType']) || d.bloodType in ['A+', 'A-', 'B+', 'B-', 'AB+', 'AB-', 'O+', 'O-', 'unknown'])
        && alergiasValidas(d, 'allergies', 'noKnownAllergies')
        && alergiasValidas(d, 'drugAllergies', 'noKnownDrugAllergies')
        && fechaOpcional(d, 'createdAt') && fechaOpcional(d, 'updatedAt') && fechaOpcional(d, 'deletedAt');
    }

    // Recibo de consentimiento (F003): inmutable. Id `documento_versión`, la hora la pone el servidor.
    function reciboValido(d, id) {
      return d.keys().hasOnly(['documento', 'version', 'acceptedAt'])
        && d.keys().hasAll(['documento', 'version', 'acceptedAt'])
        && d.documento in ['aviso_privacidad', 'terminos']
        && d.version is string && d.version.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && id == d.documento + '_' + d.version
        && d.acceptedAt == request.time;
    }

    // Lugar (F006): nombre libre de hasta 80 caracteres y su clave de comparación.
    function lugarValido(d) {
      return d.keys().hasOnly(['name', 'nameKey', 'createdAt', 'updatedAt'])
        && d.keys().hasAll(['name', 'nameKey'])
        && textoObligatorio(d, 'name', 80)
        && textoObligatorio(d, 'nameKey', 80)
        && fechaOpcional(d, 'createdAt') && fechaOpcional(d, 'updatedAt');
    }

    // Médico (F006): del usuario, no un catálogo. `deletedAt` nulo = vigente (borrado lógico).
    function medicoValido(d) {
      return d.keys().hasOnly(['fullName', 'specialty', 'phone', 'licenseNumber', 'notes', 'createdAt', 'updatedAt', 'deletedAt'])
        && d.keys().hasAll(['fullName', 'specialty'])
        && textoObligatorio(d, 'fullName', 300)
        && textoObligatorio(d, 'specialty', 40)
        && textoOpcional(d, 'phone', 40)
        && textoOpcional(d, 'licenseNumber', 40)
        && textoOpcional(d, 'notes', 20000)
        && fechaOpcional(d, 'createdAt') && fechaOpcional(d, 'updatedAt') && fechaOpcional(d, 'deletedAt');
    }

    // RF-10 / HU-02 (segunda barrera; el dominio valida lo mismo).
    // visitedAt no puede ser futura: se toleran 5 min por si el reloj del teléfono va adelantado.
    function visitaValida(d, uid) {
      return d.keys().hasOnly([
          'patientId', 'placeId', 'placeName', 'office', 'doctorId', 'doctorName', 'specialty',
          'visitType', 'visitMode', 'visitedAt', 'reason', 'doctorNotes', 'nextAppointmentAt',
          'createdAt', 'updatedAt', 'deletedAt'
        ])
        && d.keys().hasAll(['patientId', 'specialty', 'visitType', 'visitMode', 'visitedAt'])
        && d.patientId is string && d.patientId.size() <= 64
        && referenciaValida(d, 'patientId', 'patients', uid)
        && referenciaValida(d, 'placeId', 'places', uid)
        && referenciaValida(d, 'doctorId', 'doctors', uid)
        && d.specialty is string && d.specialty.size() <= 40
        && d.visitType in ['general', 'especialista', 'dentista', 'urgencias', 'otro']
        && d.visitMode == 'presencial'
        && d.visitedAt is timestamp
        && d.visitedAt <= request.time + duration.value(5, 'm')
        && textoOpcional(d, 'placeId', 64)
        && textoOpcional(d, 'placeName', 80)
        && textoOpcional(d, 'office', 80)
        && textoOpcional(d, 'doctorId', 64)
        && textoOpcional(d, 'doctorName', 200)
        && textoOpcional(d, 'reason', 2000)
        && textoOpcional(d, 'doctorNotes', 100000)
        && (!('nextAppointmentAt' in d) || d.nextAppointmentAt == null
            || (d.nextAppointmentAt is timestamp && d.nextAppointmentAt > d.visitedAt))
        && (!('deletedAt' in d) || d.deletedAt == null || d.deletedAt is timestamp);
    }

    // F011: indicación de una consulta (la lista marcable). `doneAt` nulo = pendiente.
    function indicacionValida(d) {
      return d.keys().hasOnly(['sortOrder', 'body', 'doneAt', 'createdAt', 'updatedAt'])
        && d.keys().hasAll(['sortOrder', 'body'])
        && d.sortOrder is int
        && d.body is string && d.body.size() >= 1 && d.body.size() <= 300
        && (!('doneAt' in d) || d.doneAt == null || d.doneAt is timestamp);
    }

    // Receta (F017): lista de medicamentos (máximo 20). `issuedOn` y `notes` quedan para después.
    function recetaValida(d) {
      return d.keys().hasOnly(['items', 'issuedOn', 'notes', 'createdAt', 'updatedAt'])
        && d.keys().hasAll(['items'])
        && d.items is list && d.items.size() <= 20;
    }

    // Adjunto de la receta (F016): solo la ruta en Storage y datos de la imagen, nunca una URL. Máximo 5 MB.
    // F038: `storagePath` es exactamente la ruta de la foto de ESTA consulta de ESTE usuario (la misma de `rutaDeFotoDeReceta`);
    // así un documento no puede apuntar al archivo de otra persona ni de otra consulta.
    function adjuntoValido(d, uid, visitId) {
      return d.keys().hasOnly(['storagePath', 'mimeType', 'sizeBytes', 'width', 'height', 'createdAt', 'updatedAt'])
        && d.keys().hasAll(['storagePath', 'mimeType', 'sizeBytes'])
        && d.storagePath is string && d.storagePath == 'mediq_users/' + uid + '/visits/' + visitId + '/receta.jpg'
        && d.mimeType == 'image/jpeg'
        && d.sizeBytes is int && d.sizeBytes > 0 && d.sizeBytes <= 5 * 1024 * 1024;
    }

    // Recordatorio de toma de un medicamento (F024, RF-32): una hora «HH:mm», frecuencia y fechas de inicio y fin.
    function recordatorioValido(d, uid) {
      return d.keys().hasOnly(['visitId', 'itemIndex', 'medicationName', 'dose', 'frequency', 'firstDoseTime', 'startsAt', 'endsAt', 'createdAt', 'updatedAt'])
        && d.keys().hasAll(['visitId', 'itemIndex', 'medicationName', 'frequency', 'firstDoseTime', 'startsAt', 'endsAt'])
        && textoObligatorio(d, 'visitId', 64)
        && referenciaValida(d, 'visitId', 'visits', uid)
        && d.itemIndex is int && d.itemIndex >= 0 && d.itemIndex < 20
        && textoObligatorio(d, 'medicationName', 80)
        && textoOpcional(d, 'dose', 60)
        && textoObligatorio(d, 'frequency', 60)
        && d.firstDoseTime is string && d.firstDoseTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && d.startsAt is timestamp && d.endsAt is timestamp && d.endsAt > d.startsAt
        && fechaOpcional(d, 'createdAt') && fechaOpcional(d, 'updatedAt');
    }

    // Dosis marcada como tomada (F027, RF-32): el id del documento es el de la toma, así registrarla dos veces la reescribe.
    function tomaValida(d, uid) {
      return d.keys().hasOnly(['visitId', 'itemIndex', 'medicationName', 'dose', 'scheduledFor', 'takenAt', 'createdAt'])
        && d.keys().hasAll(['visitId', 'itemIndex', 'medicationName', 'scheduledFor', 'takenAt'])
        && textoObligatorio(d, 'visitId', 64)
        && referenciaValida(d, 'visitId', 'visits', uid)
        && d.itemIndex is int && d.itemIndex >= 0 && d.itemIndex < 20
        && textoObligatorio(d, 'medicationName', 80)
        && textoOpcional(d, 'dose', 60)
        && d.scheduledFor is timestamp && d.takenAt is timestamp
        && fechaOpcional(d, 'createdAt');
    }

    match /mediq_users/{uid} {
      allow read, delete: if esDueno(uid);
      allow create, update: if esDueno(uid) && usuarioValido(request.resource.data);

      match /patients/{pacienteId} {
        allow read, delete: if esDueno(uid);
        allow create: if esDueno(uid) && pacienteValido(request.resource.data, pacienteId);
        allow update: if esDueno(uid) && pacienteValido(request.resource.data, pacienteId)
          && request.resource.data.isSelf == resource.data.isSelf;
      }

      // Sin `update`: un recibo ya guardado no se reescribe (se puede borrar solo al eliminar la cuenta).
      match /consents/{reciboId} {
        allow read, delete: if esDueno(uid);
        allow create: if esDueno(uid) && reciboValido(request.resource.data, reciboId);
      }

      match /places/{lugarId} {
        allow read, delete: if esDueno(uid);
        allow create, update: if esDueno(uid) && lugarValido(request.resource.data);
      }

      match /doctors/{medicoId} {
        allow read, delete: if esDueno(uid);
        allow create, update: if esDueno(uid) && medicoValido(request.resource.data);
      }

      // Recordatorios de toma (F024): colección plana, así la app los lee todos sin recorrer las consultas.
      match /medicationSchedules/{recordatorioId} {
        allow read, delete: if esDueno(uid);
        allow create, update: if esDueno(uid) && recordatorioValido(request.resource.data, uid);
      }

      match /doseLogs/{tomaId} {
        allow read, delete: if esDueno(uid);
        allow create, update: if esDueno(uid) && tomaValida(request.resource.data, uid);
      }

      match /visits/{visitId} {
        allow read, delete: if esDueno(uid);
        allow create, update: if esDueno(uid) && consentimientoAceptado(uid) && visitaValida(request.resource.data, uid);

        match /instructions/{indicacionId} {
          allow read, delete: if esDueno(uid);
          allow create, update: if esDueno(uid) && consentimientoAceptado(uid) && indicacionValida(request.resource.data);
        }

        // Receta de la consulta (F017): un documento `receta`; el dominio valida cada medicamento.
        match /prescriptions/{recetaId} {
          allow read, delete: if esDueno(uid);
          allow create, update: if esDueno(uid) && consentimientoAceptado(uid) && recetaValida(request.resource.data);

          // Foto de la receta (F016): un solo documento `foto` con la ruta del archivo en Storage.
          match /attachments/{adjuntoId} {
            allow read, delete: if esDueno(uid);
            allow create, update: if esDueno(uid) && consentimientoAceptado(uid) && adjuntoValido(request.resource.data, uid, visitId);
          }
        }
      }
    }
  }
}
